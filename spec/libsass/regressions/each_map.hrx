================================================================================
<===> four_variables/input.scss
@use "sass:meta";
a {
  @each $x, $y, $z, $w in (a: 1, b: 2) {
    #{$x}: $y meta.inspect($z) meta.inspect($w);
  }
}
<===> four_variables/output.css
a {
  a: 1 null null;
  b: 2 null null;
}

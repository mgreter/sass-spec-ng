<===> three_variables/input.scss
// Variables after the key/value pair are null
@use "sass:meta";
a {
  @each $key, $value, $extra in (k1: v1, k2: v2) {
    #{$key}: meta.inspect($value) meta.inspect($extra);
  }
}
<===> three_variables/output.css
a {
  k1: v1 null;
  k2: v2 null;
}

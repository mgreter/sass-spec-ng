<===> var_space/input.scss
// A `var()` color space can't be resolved, the call is passed through
a {
  channels: color(var(--space) 0.1 0.2 0.3);
  alpha: color(var(--space) 0.1 0.2 0.3 / 0.5);
  var-alpha: color(var(--s) 0.1 0.2 0.3 / var(--a));
  var-channel: color(srgb var(--r) 0.2 0.3);
  srgb-var-alpha: color(srgb 0.1 0.2 0.3 / var(--a));
}
<===> var_space/output.css
a {
  channels: color(var(--space) 0.1 0.2 0.3);
  alpha: color(var(--space) 0.1 0.2 0.3/0.5);
  var-alpha: color(var(--s) 0.1 0.2 0.3/var(--a));
  var-channel: color(srgb var(--r) 0.2 0.3);
  srgb-var-alpha: color(srgb 0.1 0.2 0.3/var(--a));
}

================================================================================
<===> number/interpolated/options.yml
:output_style: compressed

<===> number/interpolated/input.scss
a {b: #{0.5}}
<===> number/interpolated/output.css
a{b:0.5}
<===>
================================================================================
<===> number/leading_zero/options.yml
:output_style: compressed

<===> number/leading_zero/input.scss
a {
  b: 0.5px;
  c: 0.5 0.25;
  d: (0.1, 0.2);
  e: 1/0.5;
  f: 0.00000001;
}
<===> number/leading_zero/output.css
a{b:.5px;c:.5 .25;d:.1,.2;e:1/.5;f:.00000001}
<===>
================================================================================
<===> number/negative/options.yml
:output_style: compressed

<===> number/negative/input.scss
a {
  b: -0.25em;
  c: -0.0000001;
  d: -0.123456789012;
}
<===> number/negative/output.css
a{b:-0.25em;c:-0.0000001;d:-.123456789}
<===>
================================================================================
<===> number/no_rounding_needed/options.yml
:output_style: compressed

<===> number/no_rounding_needed/input.scss
a {
  b: 0.1234567891;
  c: 0.0000000001;
  d: -0.1234567891;
}
<===> number/no_rounding_needed/output.css
a{b:0.1234567891;c:0.0000000001;d:-0.1234567891}
<===>
================================================================================
<===> number/rounded/options.yml
:output_style: compressed

<===> number/rounded/input.scss
a {
  b: 0.12345678912;
  c: 0.00000000005;
  d: 0.99999999999;
  e: -0.00000000004;
}
<===> number/rounded/output.css
a{b:.1234567891;c:.0000000001;d:1;e:0}

<===> too_high/options.yml
:precision: 1000
<===> too_high/input.scss
// Precision is clamped to SassMaxPrecision (100)
@use "sass:math";
a {
  third: math.div(1, 3);
  big: 1e20 + 0.5;
  // 1000 decimals of 2^1000 (exact) would not fit the output buffer
  $huge: 1;
  @for $i from 1 through 1000 { $huge: $huge * 2; }
  huge: $huge;
}
<===> too_high/output.css
a {
  third: 0.333333333333333314829616256247390992939472198486328125;
  big: 100000000000000000000;
  huge: ;
}
<===>
================================================================================
<===> negative/options.yml
:precision: -5
<===> negative/input.scss
// Negative precision is clamped to 0
@use "sass:math";
a {
  third: math.div(1, 3);
  two-thirds: math.div(2, 3);
  big: 12345.678;
  // trailing zeros are only removed after a decimal point
  ten: 10;
  hundred: 100;
}
<===> negative/output.css
a {
  third: 0;
  two-thirds: 1;
  big: 12346;
  ten: 10;
  hundred: 100;
}

<===> int32_boundary/input.scss
// The loop counter must not overflow at 2^31
a {
  @for $i from 2147483646 through 2147483649 { b: $i; }
  @for $i from -2147483647 through -2147483650 { c: $i; }
}
<===> int32_boundary/output.css
a {
  b: 2147483646;
  b: 2147483647;
  b: 2147483648;
  b: 2147483649;
  c: -2147483647;
  c: -2147483648;
  c: -2147483649;
  c: -2147483650;
}

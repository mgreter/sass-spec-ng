<===> number_by_empty_list/input.scss
// An empty list only counts as an empty map when the other value is a
// map (or an empty list). Otherwise the value from $map2 wins, like any
// other value (LibSass used to keep the old value for every empty list).
@use 'sass:map';
@use 'sass:meta';
a {b: meta.inspect(map.deep-merge((c: 1), (c: ())))}
<===> number_by_empty_list/output.css
a {
  b: (c: ());
}

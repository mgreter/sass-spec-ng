<===> empty_list_by_empty_list/input.scss
// Both count as empty maps, so the value of $map1 is kept
@use 'sass:map';
@use 'sass:meta';
a {b: meta.inspect(map.deep-merge((c: []), (c: ())))}
<===> empty_list_by_empty_list/output.css
a {
  b: (c: []);
}

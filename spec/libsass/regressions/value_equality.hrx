<===> map_order/input.scss
// Maps with the same entries are equal regardless of their order, and
// must work as map keys (equal values need equal hashes)
@use "sass:list";
@use "sass:map";
a {
  equal: (a: 1, b: 2) == (b: 2, a: 1);                          // true
  not-equal: (a: 1, b: 2) == (a: 1, b: 3);                      // false
  get: map.get(((a: 1, b: 2): found), (b: 2, a: 1));            // found
  has-key: map.has-key(((a: 1, b: 2): x), (b: 2, a: 1));        // true
  index: list.index((a: 1, b: 2) (c: 3), (b: 2, a: 1));         // 1
  distinct: list.length(((a: 1): x, (a: 2): y));                // 2
}
<===> map_order/output.css
a {
  equal: true;
  not-equal: false;
  get: found;
  has-key: true;
  index: 1;
  distinct: 2;
}

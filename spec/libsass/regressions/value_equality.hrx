<===> calculation_keys/input.scss
// Calculations are equal if they have the same name and arguments
@use "sass:list";
@use "sass:map";
@use "sass:meta";
a {
  $c: calc(1px + var(--x));
  type: meta.type-of($c);                                             // calculation
  self: $c == $c;                                                     // true
  eq: calc(1px + var(--x)) == calc(1px + var(--x));                   // true
  ne-op: calc(1px + var(--x)) == calc(1px - var(--x));                // false
  ne-arg: calc(1px + var(--x)) == calc(2px + var(--x));               // false
  eq-units: calc(1in + var(--x)) == calc(96px + var(--x));            // true
  eq-fn: min(1px, var(--x)) == min(1px, var(--x));                    // true
  ne-name: min(1px, var(--x)) == max(1px, var(--x));                  // false
  ne-count: min(1px, var(--x)) == min(1px, var(--x), 2px);            // false
  eq-nested: calc(1px + (2px * var(--x))) == calc(1px + (2px * var(--x))); // true
  ne-nested: calc(1px + (2px * var(--x))) == calc(1px + (3px * var(--x))); // false
  ne-type: calc(1px + var(--x)) == "calc(1px + var(--x))";           // false
  key: map.get((calc(1px + var(--x)): found), calc(1px + var(--x)));  // found
  has: map.has-key((min(1px, var(--x)): x), min(1px, var(--x)));    // true
  distinct: list.length((calc(1px + var(--x)): a, calc(2px + var(--x)): b)); // 2
  index: list.index((calc(1px + var(--x)), 2), calc(1px + var(--x)));       // 1
}
<===> calculation_keys/output.css
a {
  type: calculation;
  self: true;
  eq: true;
  ne-op: false;
  ne-arg: false;
  eq-units: true;
  eq-fn: true;
  ne-name: false;
  ne-count: false;
  eq-nested: true;
  ne-nested: false;
  ne-type: false;
  key: found;
  has: true;
  distinct: 2;
  index: 1;
}

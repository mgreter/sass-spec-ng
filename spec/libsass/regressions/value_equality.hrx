<===> number_keys/input.scss
// Map lookups must agree with `==` for numbers
@use "sass:list";
@use "sass:map";
@use "sass:meta";
a {
  eq-units: 1in == 96px;                                        // true
  eq-fuzzy: 0.1 + 0.2 == 0.3;                                   // true
  get-units: map.get((1in: found), 96px);                       // found
  get-units-ms: map.get((1s: found), 1000ms);                   // found
  get-fuzzy: map.get((0.3: found), 0.1 + 0.2);                  // found
  has-units: map.has-key((1in: x), 96px);                       // true
  has-fuzzy: map.has-key((0.3: x), 0.1 + 0.2);                  // true
  merge-units: meta.inspect(map.merge((1in: a), (96px: b)));    // (1in: b)
  merge-len: list.length(map.merge((1in: a), (96px: b)));       // 1
  get-neg-zero: map.get((0: found), -0);                        // found
  get-tiny: map.get((0: found), 1e-13);                         // found
  distinct-units: list.length((1px: a, 1em: b));                // 2
  distinct-values: list.length((1: a, 1.001: b));               // 2
  unitless-vs-unit: map.get((1: x), 1px) == null;               // true
  index-units: list.index(1in 2in, 192px);                      // 2
  nested-key: map.get(((1in: a): found), (96px: a));            // found
}
<===> number_keys/output.css
a {
  eq-units: true;
  eq-fuzzy: true;
  get-units: found;
  get-units-ms: found;
  get-fuzzy: found;
  has-units: true;
  has-fuzzy: true;
  merge-units: (1in: b);
  merge-len: 1;
  get-neg-zero: found;
  get-tiny: found;
  distinct-units: 2;
  distinct-values: 2;
  unitless-vs-unit: true;
  index-units: 2;
  nested-key: found;
}

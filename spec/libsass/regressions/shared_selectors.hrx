================================================================================
<===> load_css/plain_css_parent/nested_twice/input.scss
@use "sass:meta";
x {@include meta.load-css("other")}
y {@include meta.load-css("other")}
<===> load_css/plain_css_parent/nested_twice/other.css
.a {
  &.b {c: d}
  .e & {f: g}
  & > .h {i: j}
}
& .top {m: n}
<===> load_css/plain_css_parent/nested_twice/output.css
x {
  & .top {
    m: n;
  }
}
x .a {
  &.b {
    c: d;
  }
  .e & {
    f: g;
  }
  & > .h {
    i: j;
  }
}

y {
  & .top {
    m: n;
  }
}
y .a {
  &.b {
    c: d;
  }
  .e & {
    f: g;
  }
  & > .h {
    i: j;
  }
}
<===>
================================================================================
<===> load_css/pseudo_parent/nested_then_root/input.scss
@use "sass:meta";
x {@include meta.load-css("other")}
@include meta.load-css("other");
<===> load_css/pseudo_parent/nested_then_root/_other.scss
:not(&) {c: d}
.u:is(& .v) {w: x}
<===> load_css/pseudo_parent/nested_then_root/output.css
:not(x) {
  c: d;
}
.u:is(x .v) {
  w: x;
}

:not(&) {
  c: d;
}

.u:is(& .v) {
  w: x;
}

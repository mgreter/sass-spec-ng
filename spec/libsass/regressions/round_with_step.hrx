<===> zero_step/input.scss
a {
  number: round(nearest, 5, 0);
  unit: round(up, 5px, 0px);
  zero: round(down, 0, 0);
  infinity: round(up, infinity, 0);
}
<===> zero_step/output.css
a {
  number: calc(NaN);
  unit: calc(NaN * 1px);
  zero: calc(NaN);
  infinity: calc(NaN);
}

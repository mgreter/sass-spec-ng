<===> nan_infinite_step/input.scss
// NaN stays NaN with an infinite step (like dart-sass `_roundWithStep`)
a {
  nearest: round(nearest, NaN, infinity);
  up: round(up, NaN, infinity);
  down: round(down, NaN, infinity);
  to-zero: round(to-zero, NaN, infinity);
  up-negative-infinity: round(up, NaN, -infinity);
}
<===> nan_infinite_step/output.css
a {
  nearest: calc(NaN);
  up: calc(NaN);
  down: calc(NaN);
  to-zero: calc(NaN);
  up-negative-infinity: calc(NaN);
}

================================================================================
<===> media/condition/options.yml
:output_style: compressed

<===> media/condition/input.scss
@media (min-width: 1px), print {a {x: 1}}
<===> media/condition/output.css
@media(min-width: 1px),print{a{x:1}}
<===>
================================================================================
<===> media/conditions/options.yml
:output_style: compressed

<===> media/conditions/input.scss
@media (min-width: 1px) and (max-width: 2px) {a {x: 1}}
@media (min-width: 1px) or (max-width: 2px) {b {x: 2}}
<===> media/conditions/output.css
@media(min-width: 1px)and (max-width: 2px){a{x:1}}@media(min-width: 1px)or (max-width: 2px){b{x:2}}

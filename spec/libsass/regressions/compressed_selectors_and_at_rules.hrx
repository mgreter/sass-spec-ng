================================================================================
<===> media/not/options.yml
:output_style: compressed

<===> media/not/input.scss
@media not screen and (color) {a {x: 1}}
@media (not (color)) {b {x: 2}}
<===> media/not/output.css
@media not screen and (color){a{x:1}}@media not (color){b{x:2}}

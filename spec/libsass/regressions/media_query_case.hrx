<===> type_upper_inner/input.scss
// Media types are compared case-insensitively when nested queries
// are merged; the comparison used to work only if the inner type
// was lowercase, otherwise the rule was dropped.
@media screen {
  @media SCREEN and (a: b) {x {y: z}}
}
<===> type_upper_inner/output.css
@media screen and (a: b) {
  x {
    y: z;
  }
}

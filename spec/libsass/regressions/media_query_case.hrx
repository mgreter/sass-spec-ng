<===> both_not/input.scss
@media not screen and (a: b) {
  @media not SCREEN and (a: b) and (c: d) {x {y: z}}
}
<===> both_not/output.css
@media not screen and (a: b) and (c: d) {
  x {
    y: z;
  }
}

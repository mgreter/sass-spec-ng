<===> string_and_list/input.scss
// Integer arguments beyond 32 bits must not wrap around
@use "sass:list";
@use "sass:math";
@use "sass:meta";
@use "sass:string";
a {
  slice-end-big: string.slice("abcde", 2, 3000000000);          // "bcde"
  slice-start-big: string.slice("abcde", 3000000000);           // ""
  slice-start-neg-big: string.slice("abcde", -3000000000, 2);   // "ab"
  insert-big: string.insert("abc", "X", 3000000000);            // "abcX"
  insert-neg-big: string.insert("abc", "X", -3000000000);       // "Xabc"
  split-limit-big: meta.inspect(string.split("a b c", " ", 3000000000)); // ["a", "b", "c"]
  slice-normal: string.slice("abcde", 2, 4);                    // "bcd"
  slice-neg: string.slice("abcde", -3, -2);                     // "cd"
  insert-normal: string.insert("abc", "X", 2);                  // "aXbc"
  insert-neg: string.insert("abc", "X", -1);                    // "abcX"
  nth-normal: list.nth(10 20 30, -1);                           // 30
  $r: math.random(3000000000);
  random-big: ($r == math.round($r)) and ($r >= 1) and ($r <= 3000000000); // true
}
<===> string_and_list/output.css
a {
  slice-end-big: "bcde";
  slice-start-big: "";
  slice-start-neg-big: "ab";
  insert-big: "abcX";
  insert-neg-big: "Xabc";
  split-limit-big: ["a", "b", "c"];
  slice-normal: "bcd";
  slice-neg: "cd";
  insert-normal: "aXbc";
  insert-neg: "abcX";
  nth-normal: 30;
  random-big: true;
}

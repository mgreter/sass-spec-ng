<===> max_code_point/input.scss
// U+10FFFF is the largest valid code point (not replaced with U+FFFD)
@use "sass:string";
a {
  not-replaced: "\10FFFF" != "\FFFD";
  same-code-point: "\10FFFF" == "\10ffff";
  length: string.length("\10FFFF");
}
<===> max_code_point/output.css
a {
  not-replaced: true;
  same-code-point: true;
  length: 1;
}

================================================================================
<===> escaped_non_ascii/input.scss
// An escaped multi-byte character is read as a whole
@use "sass:string";
a {
  equal: "\é" == "é";
  length: string.length("x\éx");
  index: string.index("\é", "é");
}
<===> escaped_non_ascii/output.css
a {
  equal: true;
  length: 3;
  index: 1;
}

<===> single_line/input.sass
// Non-ASCII text in a loud comment of the indented syntax must be
// copied byte for byte (it was utf8-encoded a second time)
/* café */
a
  b: c
<===> single_line/output.css
@charset "UTF-8";
/* café */
a {
  b: c;
}

================================================================================
<===> unused_conflict/namespaced/input.scss
@use "left" as *;
@use "right" as *;
@use "right" as r;
a {
  b: r.$a;
  c: r.f();
  @include r.m;
}
<===> unused_conflict/namespaced/_left.scss
$a: left;
@function f() {@return left}
@mixin m {x: left}
<===> unused_conflict/namespaced/_right.scss
$a: right;
@function f() {@return right}
@mixin m {x: right}
<===> unused_conflict/namespaced/output.css
a {
  b: right;
  c: right;
  x: right;
}
<===>
================================================================================
<===> unused_conflict/unused/input.scss
@use "left" as *;
@use "right" as *;
a {b: c}
<===> unused_conflict/unused/_left.scss
$a: left;
@function f() {@return left}
@mixin m {x: left}
<===> unused_conflict/unused/_right.scss
$a: right;
@function f() {@return right}
@mixin m {x: right}
<===> unused_conflict/unused/output.css
a {
  b: c;
}

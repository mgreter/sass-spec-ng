<===> README.md
Like dart-sass (1.104), results of rounding functions, modulo and color channels
are never negative zero, while other numbers keep their sign when serialized.
<===>
================================================================================
<===> color/nan/input.scss
a {
  lch: lch(50% 10 calc(NaN));
  oklch: oklch(50% 0.1 calc(infinity));
  hsl: hsl(calc(NaN) 50% 50%);
  srgb: color(srgb calc(NaN) 0 0);
}
<===> color/nan/output.css
a {
  lch: lch(50% 10 0deg);
  oklch: oklch(50% 0.1 0deg);
  hsl: hsl(0, 50%, 50%);
  srgb: color(srgb 0 0 0);
}
<===>
================================================================================
<===> color/polar/input.scss
@use 'sass:color';
a {
  lch: lch(-0% -0 -0deg);
  hue: color.channel(lch(50% 10 -0deg), 'hue');
  hsl: hsl(-0, 0%, 0%);
}
<===> color/polar/output.css
a {
  lch: lch(0% 0 0deg);
  hue: 0deg;
  hsl: hsl(0, 0%, 0%);
}
<===>
================================================================================
<===> color/rgb/input.scss
@use 'sass:color';
a {
  rgb: rgb(-0, -0, -0);
  rgba: rgba(-0, 0, 0, 0.5);
  red: color.channel(rgb(-0, 0, 0), 'red');
}
<===> color/rgb/output.css
a {
  rgb: rgb(0, 0, 0);
  rgba: rgba(0, 0, 0, 0.5);
  red: 0;
}
<===>
================================================================================
<===> modulo/input.scss
a {
  b: -0 % -1;
  c: -0 % 1;
}
<===> modulo/output.css
a {
  b: 0;
  c: 0;
}
<===>
================================================================================
<===> rounding/calc/input.scss
a {
  round: round(-0.4);
  up: round(up, -0.4, 1);
  to-zero: round(to-zero, -0.4, 1);
  units: round(-0.4px, 1px);
}
<===> rounding/calc/output.css
a {
  round: 0;
  up: 0;
  to-zero: 0;
  units: 0px;
}
<===>
================================================================================
<===> rounding/math/input.scss
@use 'sass:math';
a {
  round: math.round(-0.4);
  floor: math.floor(-0.0);
  ceil: math.ceil(-0.5);
}
<===> rounding/math/output.css
a {
  round: 0;
  floor: 0;
  ceil: 0;
}

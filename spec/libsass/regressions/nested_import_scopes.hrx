<===> after/variable/_n.scss
$a: 0;
b {c: $a}
<===> after/variable/output.css
a b {
  c: 0;
}
a {
  d: 0;
}
<===>
================================================================================
<===> contexts/nested_then_root/input.scss
a {@import "n"}
@import "n";
e {f: $a}
<===> contexts/nested_then_root/_n.scss
$a: 0;
b {c: $a}
<===> contexts/nested_then_root/output.css
a b {
  c: 0;
}

b {
  c: 0;
}

e {
  f: 0;
}
<===>
================================================================================
<===> contexts/root_then_nested/input.scss
$o: 1;
@import "r";
a {$o: 5; @import "r"; d: $o}
e {f: $o}
<===> contexts/root_then_nested/_r.scss
b {c: $o}
$o: 2;
<===> contexts/root_then_nested/output.css
b {
  c: 1;
}

a b {
  c: 5;
}
a {
  d: 2;
}

e {
  f: 2;
}
<===>
================================================================================
<===> contexts/two_rules/input.scss
a {$o: 1; @import "r"; d: $o}
c {$o: 3; @import "r"; d: $o}
<===> contexts/two_rules/_r.scss
b {c: $o}
$o: 2;
<===> contexts/two_rules/output.css
a b {
  c: 1;
}
a {
  d: 2;
}

c b {
  c: 3;
}
c {
  d: 2;
}

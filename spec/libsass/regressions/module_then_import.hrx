<===> README.md
# Stylesheets loaded as a module and also imported

A file loaded via `@use` or `load-css()` was cached and later reused
by `@import`, so the import didn't expose its members. Also variables
of a nested import (e.g. inside a style rule) were not found.
<===>
================================================================================
<===> load_css_then_import/input.scss
@use "sass:meta";
@include meta.load-css("f");
@import "f";
a {b: $a}
<===> load_css_then_import/_f.scss
@forward "x";
<===> load_css_then_import/_x.scss
$a: 0 !default;
b {c: $a}
<===> load_css_then_import/output.css
b {
  c: 0;
}

b {
  c: 0;
}

a {
  b: 0;
}
<===>
================================================================================
<===> nested_import/assign_outer/input.scss
a {$o: 1; @import "r"; d: $o}
<===> nested_import/assign_outer/_r.scss
b {c: $o}
$o: 2;
<===> nested_import/assign_outer/output.css
a b {
  c: 1;
}
a {
  d: 2;
}
<===>
================================================================================
<===> nested_import/default/input.scss
a {@import "d"}
<===> nested_import/default/_d.scss
$a: 0 !default;
b {c: $a}
<===> nested_import/default/output.css
a b {
  c: 0;
}
<===>
================================================================================
<===> nested_import/default_outer/input.scss
a {$a: 5; @import "d"}
<===> nested_import/default_outer/_d.scss
$a: 0 !default;
b {c: $a}
<===> nested_import/default_outer/output.css
a b {
  c: 5;
}
<===>
================================================================================
<===> nested_import/function/input.scss
a {@import "f"}
<===> nested_import/function/_f.scss
$a: 1;
@function ff() {@return $a}
b {c: ff()}
<===> nested_import/function/output.css
a b {
  c: 1;
}
<===>
================================================================================
<===> nested_import/media/input.scss
@media screen {a {b {@import "n"}}}
<===> nested_import/media/_n.scss
$a: 0;
c {d: $a}
<===> nested_import/media/output.css
@media screen {
  a b c {
    d: 0;
  }
}
<===>
================================================================================
<===> nested_import/mixin/input.scss
a {@import "m"}
<===> nested_import/mixin/_m.scss
$a: 1;
@mixin mm {m: $a}
b {@include mm}
<===> nested_import/mixin/output.css
a b {
  m: 1;
}
<===>
================================================================================
<===> nested_import/twice/input.scss
a {@import "n"}
c {@import "n"}
<===> nested_import/twice/_n.scss
$a: 0;
b {c: $a}
<===> nested_import/twice/output.css
a b {
  c: 0;
}

c b {
  c: 0;
}

<===> trailing_separator/input.scss
// The rest after the last separator is always returned, even if empty
@use "sass:list";
@use "sass:meta";
@use "sass:string";
$result: string.split("a,b,", ",");
a {
  value: meta.inspect($result);
  length: list.length($result);
}
<===> trailing_separator/output.css
a {
  value: ["a", "b", ""];
  length: 3;
}

<===> clip/input.scss
@use "sass:color";
a {
  b: color.to-gamut(
    color.change(lab(50% 500 -999999), $lightness: 150%),
    $method: clip
  );
}

<===> clip/output.css
a {
  b: color-mix(in lab, color(xyz 6530020637.921538 2172031124.122868 137328815479.04425) 100%, black);
}

<===> clip/output-libsass.css
a {
  b: color-mix(in lab, color(xyz 6530020637.921538353 2172031124.1228680611 137328815479.0442504883) 100%, black);
}

